{
  "name": "michal-planeta-profile-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "profile:build": "bash scripts/profile_build.sh",
    "profile:check": "bash scripts/profile_check.sh",
    "profile:probe": "bash scripts/profile_probe.sh",
    "profile:tokens": "bash scripts/profile_tokens.sh",
    "control-room:data": "pnpm --filter @michal-planeta/control-room generate:contracts",
    "control-room:typecheck": "pnpm --filter @michal-planeta/control-room typecheck",
    "control-room:test": "pnpm --filter @michal-planeta/control-room test",
    "control-room:test:e2e": "pnpm --filter @michal-planeta/control-room test:e2e",
    "control-room:build": "pnpm --filter @michal-planeta/control-room build",
    "control-room:check": "tests/shell/control_room_check_test.sh && bash scripts/control_room_check.sh",
    "control-room:dev": "pnpm --filter @michal-planeta/control-room dev"
  }
}
